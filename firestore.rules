rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'customer'
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'photoURL', 'role', 'createdAt'
        ]);

      allow read: if isSignedIn()
        && (request.auth.uid == userId || isAdmin());

      allow update, delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if isSignedIn();

      allow create, update, delete: if isAdmin();

      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reserved'])
        && request.resource.data.reserved is number
        && request.resource.data.reserved >= 0
        && request.resource.data.reserved <= resource.data.stock;
    }

    match /orders/{orderId} {
      // Customers can create their own orders.
      // UPI orders start as draft.
      // Cash orders start as pending.
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && (
          (
            request.resource.data.paymentMethod == 'cash'
            && request.resource.data.status == 'pending'
          )
          ||
          (
            request.resource.data.paymentMethod == 'upi'
            && request.resource.data.status == 'draft'
          )
        )
        && request.resource.data.keys().hasOnly([
          'customerName',
          'userId',
          'items',
          'total',
          'status',
          'paymentMethod',
          'createdAt'
        ])
        && request.resource.data.paymentMethod in ['upi', 'cash']
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.total <= 50000
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0;

      // Customers can read their own orders.
      // Admins can read all orders.
      allow read: if isSignedIn()
        && (
          resource.data.userId == request.auth.uid
          || isAdmin()
        );

      // Admins retain full control over orders.
      allow update, delete: if isAdmin();

      // Customers can cancel their own active orders.
      // For UPI, only a draft order can be cancelled.
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status in ['draft', 'pending', 'utr_submitted']
        && request.resource.data.status == 'cancelled'
        && request.resource.data.cancelledBy == 'customer'
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['status', 'cancelledBy']);
    }

    match /requests/{requestId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.resolved == false
        && request.resource.data.keys().hasOnly([
          'userId',
          'customerName',
          'message',
          'status',
          'resolved',
          'createdAt'
        ])
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.message is string
        && request.resource.data.message.size() < 500;

      allow read: if isSignedIn()
        && (
          resource.data.userId == request.auth.uid
          || isAdmin()
        );

      allow update, delete: if isAdmin();

      // A customer may only acknowledge their own fulfilled request. The request
      // document stays in Firestore so it remains available to administrators.
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'completed'
        && !('customerSeenAt' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customerSeenAt'])
        && request.resource.data.customerSeenAt == request.time;
    }

    match /ledger/{id} {
      allow read, write: if isAdmin();
    }

    match /settings/{id} {
      allow read: if isSignedIn();

      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['open'])
        && request.resource.data.open is bool;
    }
  }
}
